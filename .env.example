# Webhook, an den jede Formular-Einsendung als JSON gesendet wird (z. B. Make, Zapier, n8n)
WEBHOOK_URL=

# Optional: Pfad der CSV-Datei mit allen Einsendungen (Standard: data/submissions.csv)
SUBMISSIONS_CSV_PATH=

# Optional: Schlüssel für den CSV-Download unter /api/submissions?key=...
EXPORT_KEY=

# ---------- E-Mail an den zuständigen Bildungsberater ----------
# Absender-Postfach (bei Microsoft 365 ein vorhandenes Postfach oder freigegebenes Postfach)
MAIL_FROM=

# Weg 1 — Microsoft 365 über die Graph-API (empfohlen bei M365).
# App-Registrierung in Entra ID mit Anwendungsberechtigung "Mail.Send" (Administratorzustimmung).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Weg 2 — beliebiger SMTP-Server (wird genutzt, wenn GRAPH_* leer ist)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: zusätzliche Empfänger aller Leads (Komma-getrennt), z. B. Geschäftsführung
LEADS_CC=
