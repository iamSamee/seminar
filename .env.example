# Webhook, an den jede Formular-Einsendung als JSON gesendet wird (z. B. Make, Zapier, n8n)
WEBHOOK_URL=

# Optional: Pfad der CSV-Datei mit allen Einsendungen (Standard: data/submissions.csv)
SUBMISSIONS_CSV_PATH=

# Optional: Schlüssel für den CSV-Download unter /api/submissions?key=...
EXPORT_KEY=
